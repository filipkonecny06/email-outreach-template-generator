NODE_ENV=development
PORT=3000
TRUST_PROXY=false
BODY_LIMIT=100kb
SESSION_COOKIE_NAME=outreach.sid
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-this-with-a-unique-48-character-minimum-secret
SESSION_MAX_AGE_MS=86400000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outreach_generator
DB_USER=outreach
DB_PASSWORD=outreach
# Set DB_SSL=true when the database requires TLS. Keep certificate verification enabled.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# For managed databases, provide the CA certificate with newlines encoded as \n.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
