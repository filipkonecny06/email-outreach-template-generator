NODE_ENV=development
PORT=3000
APP_NAME=OutreachOps
TRUST_PROXY=false
BODY_LIMIT=100kb
SESSION_COOKIE_NAME=outreach.sid
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-this-with-a-unique-48-character-minimum-secret
SESSION_MAX_AGE_MS=86400000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outreach_generator
DB_USER=outreach
DB_PASSWORD=outreach
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
