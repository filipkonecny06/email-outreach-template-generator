{
  "name": "outreach-email-template-generator",
  "version": "2.0.0",
  "description": "A secure, deterministic outreach-email workshop with a version-controlled template catalog",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:coverage": "c8 --include=src/services/** --include=src/config/environment.js --check-coverage --lines 80 --functions 80 --branches 70 node --test",
    "check": "npm run format:check && npm run lint && npm run test:coverage",
    "catalog:validate": "node scripts/catalog.js validate",
    "catalog:list": "node scripts/catalog.js list",
    "catalog:sync:dry-run": "node scripts/catalog.js sync",
    "catalog:sync": "node scripts/catalog.js sync --apply",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run db:migrate && npm run catalog:sync"
  },
  "keywords": [
    "outreach",
    "express",
    "sequelize",
    "email",
    "template-catalog"
  ],
  "author": "Filip Konecny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkonecny06/email-outreach-template-generator.git"
  },
  "bugs": {
    "url": "https://github.com/filipkonecny06/email-outreach-template-generator/issues"
  },
  "homepage": "https://github.com/filipkonecny06/email-outreach-template-generator#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "bcrypt": "^6.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.2.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "morgan": "^1.11.0",
    "mysql2": "^3.17.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.7.4",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
