<%# Authenticated workspace composed from a template list, contextual form, and live preview. %>
<section class="generator-grid" data-page="generator" aria-busy="false">
  <%- include('partials/sidebar') %>

  <section class="panel form-panel" aria-label="Input Form">
    <h1>Build an outreach email</h1>
    <p class="muted">Choose a campaign pattern, add only the details it needs, then review the plain-text output before sending.</p>
    <h2>Campaign Inputs</h2>
    <%# Server-side field state matches the browser controller before JavaScript initializes. %>
    <% const activeFields = new Set(selectedTemplate ? selectedTemplate.requiredFields : []); %>
    <form id="generatorForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" id="templateId" name="templateId" value="<%= selectedTemplate ? selectedTemplate.id : '' %>" />
      <div class="form-grid">
        <label data-outreach-field="firstName" <%= activeFields.has('firstName') ? '' : 'hidden' %>>First Name<input class="input" name="firstName" <%= activeFields.has('firstName') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="siteName" <%= activeFields.has('siteName') ? '' : 'hidden' %>>Site Name<input class="input" name="siteName" <%= activeFields.has('siteName') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="topic" <%= activeFields.has('topic') ? '' : 'hidden' %>>Topic<input class="input" name="topic" <%= activeFields.has('topic') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="articleUrl" <%= activeFields.has('articleUrl') ? '' : 'hidden' %>>Article URL<input class="input" name="articleUrl" type="url" <%= activeFields.has('articleUrl') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="brokenUrl" <%= activeFields.has('brokenUrl') ? '' : 'hidden' %>>Broken URL<input class="input" name="brokenUrl" type="url" <%= activeFields.has('brokenUrl') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="yourUrl" <%= activeFields.has('yourUrl') ? '' : 'hidden' %>>Your URL<input class="input" name="yourUrl" type="url" <%= activeFields.has('yourUrl') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="offerAngle" <%= activeFields.has('offerAngle') ? '' : 'hidden' %>>Offer Angle<input class="input" name="offerAngle" <%= activeFields.has('offerAngle') ? 'required' : 'disabled' %> /></label>
        <label data-outreach-field="specificCompliment" <%= activeFields.has('specificCompliment') ? '' : 'hidden' %>>Specific Compliment<input class="input" name="specificCompliment" <%= activeFields.has('specificCompliment') ? 'required' : 'disabled' %> /></label>
        <label>Sender Name (optional)<input class="input" name="senderName" autocomplete="name" /></label>
      </div>

      <div class="form-grid campaign-controls">
        <label>Tone
          <select class="input" name="tone">
            <option value="direct">Direct</option>
            <option value="friendly">Friendly</option>
            <option value="formal">Formal</option>
          </select>
        </label>
        <label>Length
          <select class="input" name="length">
            <option value="short">Short</option>
            <option value="medium">Medium</option>
            <option value="long">Long</option>
          </select>
        </label>
      </div>

      <label class="checkbox-row"><input type="checkbox" name="includeFollowUps" id="includeFollowUps" /> Include follow-up sequence</label>
      <button type="submit" class="btn">Generate Preview</button>
      <%# The live region announces validation and transport failures without moving focus. %>
      <p id="formError" class="form-error" role="alert" aria-live="assertive"></p>
    </form>
  </section>

  <section class="panel preview-panel" aria-label="Output Preview" aria-live="polite">
    <h2>Live Output Preview</h2>
    <div class="preview-block">
      <h3>Subject</h3>
      <pre id="subjectPreview" class="preview-text">Select a template and enter campaign data.</pre>
    </div>
    <div class="preview-block">
      <h3>Body</h3>
      <pre id="bodyPreview" class="preview-text"></pre>
    </div>
    <div id="followUpContainer"></div>

    <div class="preview-actions sticky-actions">
      <button class="btn btn-secondary" id="copySubjectBtn" type="button">Copy Subject</button>
      <button class="btn btn-secondary" id="copyBodyBtn" type="button">Copy Body</button>
      <button class="btn btn-secondary" id="downloadTxtBtn" type="button">Download .txt</button>
      <button class="btn btn-secondary" id="exportCsvBtn" type="button">Export CSV Row</button>
      <button class="btn" id="saveHistoryBtn" type="button">Save to History</button>
    </div>
  </section>
</section>
<%# Dependencies are loaded before the small bootstrap file; defer preserves declaration order. %>
<script src="/js/outreach-api-client.js" defer></script>
<script src="/js/outreach-form-view.js" defer></script>
<script src="/js/outreach-template-list-controller.js" defer></script>
<script src="/js/outreach-export-service.js" defer></script>
<script src="/js/outreach-generator-controller.js" defer></script>
<script src="/js/generator.js" defer></script>
